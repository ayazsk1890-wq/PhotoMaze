# ==============================================================================
# PHOTOMAZE — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# All variables below contain variable names only with no hardcoded secrets or values.
# Populate these in Render Environment Variables or your local .env.local file.
# ==============================================================================

# Application Environment
NODE_ENV=
PORT=
NEXT_PUBLIC_APP_URL=

# Supabase Authentication & Storage (Optional — 100% free local guest mode active by default)
# Configured if syncing projects or signing in with Google/Email
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Background Removal AI Provider (Optional: client_webgpu (default, 100% free), photoroom, replicate)
AI_BG_REMOVAL_PROVIDER=
PHOTOROOM_API_KEY=

# Outfit Replacement AI (Optional: IDM-VTON model on Replicate)
# Disclosures & Links:
# - Model: IDM-VTON (virtual try-on)
# - Estimated Cost per image: ~$0.003
# - Token URL: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
